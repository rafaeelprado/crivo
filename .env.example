# Copie este arquivo para .env e preencha. O .env NUNCA vai para o git.

# --- Claude API ---
# Pegue em https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-troque-por-sua-chave

# Modelo de geração. Haiku é o mais barato e rápido.
ANSWER_MODEL=claude-haiku-4-5

# --- Modelos locais (baixados do HuggingFace na primeira execução) ---
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# --- Recuperação ---
# Quantos chunks a busca híbrida traz antes do reranking
RETRIEVE_TOP_K=20
# Quantos chunks sobrevivem ao reranking e entram no prompt
RERANK_TOP_N=5
# Abaixo deste score no melhor chunk, o sistema abstém sem chamar o LLM.
# Calibrado na Fase 7 — o valor inicial é um chute honesto.
MIN_RERANK_SCORE=0.35
# Similaridade mínima entre a citação devolvida e o texto do chunk.
CITATION_MATCH_THRESHOLD=0.90

# --- Chunking ---
MAX_CHUNK_TOKENS=1200

# --- Servidor ---
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
